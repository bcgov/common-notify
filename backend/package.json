    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@types/markdown-it": "^14.1.2",
    "axios": "^1.17.0",
    "bull": "^4.14.1",
    "chokidar": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.0",
    "express-prom-bundle": "^8.0.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.7",
    "jose": "^6.2.2",
    "jwks-rsa": "^4.0.1",
    "libphonenumber-js": "^1.13.11",
    "markdown-it": "^14.1.1",
    "mjml": "^5.3.0",
    "mustache": "^4.2.0",
    "nest-winston": "^2.0.0",
    "nodemailer": "^10.0.0",
    "papaparse": "^5.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.0",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.59.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.12",
    "@types/express": "^5.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "istanbul-badges-readme": "^1.9.0",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "hono@<4.11.7": "4.11.7",
    "reflect-metadata": "^0.2.2",
    "brace-expansion@1": "^1.1.12",
    "brace-expansion@2": "^2.0.2",
    "brace-expansion@5": "^5.0.8",
    "uuid": "$uuid",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.2"
    },
    "chevrotain": {
      "lodash": "4.17.23"
    }
  }
