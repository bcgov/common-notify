{
  "author": "NRIDS",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "deploy": "npm ci --ignore-scripts --no-update-notifier && npm run build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "make-badges": "istanbul-badges-readme --logo=vitest --exitCode=1",
    "make-badges:ci": "npm run make-badges -- --ci",
    "test": "vitest --dir src",
    "test:unit": "vitest --dir src",
    "test:unit:cov": "vitest run --coverage",
    "test:integration": "vitest --dir test",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@azure/communication-sms": "1.1.0",
    "@nestjs/cli": "^12.0.0",
