# DEV example only. Copy to .env; that filename is gitignored.
# These are Notify-owned CSS service-account settings, not a user JWT.
# Compose (repo root): docker compose --env-file mcp-servers/cstar/.env -f .devcontainer/docker-compose.yml up -d --build --no-deps --force-recreate cstar-mcp
# Compose maps CSTAR_MCP_API_KEY (or its local default) to MCP_API_KEY.
# Standalone: set MCP_API_KEY below, then node --env-file=.env src/server.js
MCP_API_KEY=
# Optional Compose-only override; must match the Notify backend's shared key.
# CSTAR_MCP_API_KEY=
CSTAR_API_URL=https://dev.connect.digital.gov.bc.ca
CSTAR_TOKEN_URL=https://dev.loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/token
CSTAR_CLIENT_ID=notify-cstar-integration-6738
# Populate privately using the existing Notify CSS integration's DEV secret.
CSTAR_CLIENT_SECRET=
CSTAR_SCOPE=
PORT=3101
