# Standalone process: node --env-file=.env src/server.js
# Compose uses CSTAR_MCP_API_KEY as the input name for this same shared key.
MCP_API_KEY=
CSTAR_API_URL=
CSTAR_TOKEN_URL=
CSTAR_CLIENT_ID=
CSTAR_CLIENT_SECRET=
CSTAR_SCOPE=
PORT=3101
# Optional local demo only; use actual external CSTAR tenant IDs from your login.
# NODE_ENV=development
# CSTAR_MOCK_MODE=true
# CSTAR_MOCK_TENANT_IDS=
