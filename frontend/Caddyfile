# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	# Proxy requests to API Gateway (Kong): the Notify API under /api, and the GC
	# Notify-compatible API under /gcnotify, which has no /api prefix (see backend/src/app.ts).
	# On PR deploys GATEWAY_PATH_PREFIX is "/pr-<n>" so requests are proxied to the
	# PR-specific Kong routes (/pr-<n>/api/*, /pr-<n>/gcnotify/*). It is empty on dev/test/prod, which
	# makes the rewrite an identity no-op. {uri} preserves the query string.
	@gateway path /api* /gcnotify/*
	reverse_proxy @gateway {$VITE_API_GATEWAY_NOTIFY_URL} {
		rewrite {$GATEWAY_PATH_PREFIX:}{uri}
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Real-IP {remote_host}
		header_down -Via
		header_down -X-Kong-*
	}

	# Serve dynamic runtime configuration - MUST come before file_server
	handle_path /static/config.js {
		header Content-Type text/javascript
		respond `window.VITE_KEYCLOAK_URL="{$VITE_KEYCLOAK_URL}";
window.VITE_KEYCLOAK_REALM="{$VITE_KEYCLOAK_REALM}";
window.VITE_KEYCLOAK_CLIENT_ID="{$VITE_KEYCLOAK_CLIENT_ID}";
window.VITE_API_GATEWAY_NOTIFY_URL="{$VITE_API_GATEWAY_NOTIFY_URL}";
window.VITE_MAX_NOTIFICATION_RESULTS_PER_PAGE="{$VITE_MAX_NOTIFICATION_RESULTS_PER_PAGE}";
window.VITE_CSTAR_API_URL="{$VITE_CSTAR_API_URL}";
window.VITE_CSTAR_TENANT_SETUP_URL="{$VITE_CSTAR_TENANT_SETUP_URL}";`
	}

	# Nest generates the API spec from the controllers and serves it at
	# /api/docs, which the gateway proxy above forwards to Kong. These keep
	# links to the older /api-docs path working.
	redir /api-docs /api/docs permanent
	redir /api-docs/* /api/docs permanent

	root * /srv
	encode zstd gzip
	# Only existing Vite content-hashed assets are immutable. Missing assets must
	# return 404 rather than an immutable copy of the SPA shell.
	handle /assets/* {
		@immutable {
			path_regexp hashed_asset ^/assets/.+-[A-Za-z0-9_-]{8,}\.[^/]+$
			file {path}
		}
		route {
			header Cache-Control "no-store"
			header @immutable Cache-Control "public, max-age=31536000, immutable"
			file_server {
				pass_thru
			}
			respond "Not Found" 404
		}
	}
	@uncached not path /assets/*
	header @uncached >Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
	file_server
	@spa_router {
		not path /api*
		not path /gcnotify/*
		not path /static/config.js
		not path /assets/*
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa_router {http.matchers.file.relative}
	header {
		-Server
		# Caddy also adds its own Via header after upstream header filtering.
		-Via
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Runtime component styling and email previews still need inline styles;
		# scripts are external files only. Keep ZAP's CSP rule active.
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca;
			script-src 'self' https://*.gov.bc.ca;
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com 'unsafe-inline';
			font-src 'self' https://fonts.gstatic.com;
			img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org;
			frame-ancestors 'self';
			form-action 'self';
			connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Opener-Policy "same-origin"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
