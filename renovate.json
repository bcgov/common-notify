{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for common-notify: all updates consolidated into a single manually-reviewed PR",
  "extends": ["github>bcgov/renovate-config#2025.10.1"],
  "schedule": ["before 4am on Monday"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Consolidate every update (all managers, all update types incl. major) into a single PR; always reviewed manually, never auto-merged",
      "matchManagers": [
        "npm",
        "dockerfile",
        "docker-compose",
        "github-actions",
        "helm-values",
        "helmv3"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "bump"
      ],
      "groupName": "all dependencies",
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "groupName": "all dependencies",
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "all dependencies",
    "automerge": false
  },
  "helm-values": {
    "enabled": true,
    "managerFilePatterns": ["/charts/.+/values\\.ya?ml$/"]
  },
  "helmv3": {
    "enabled": true,
    "managerFilePatterns": ["/charts/.+/Chart\\.ya?ml$/"]
  }
}
