CHES_TOKEN_URL=
CHES_CLIENT_ID=
CHES_CLIENT_SECRET=
DEFAULT_EMAIL_FROM=

GC_NOTIFY_BASE_URL=

# CSTAR Integration (for role-based access control)
VITE_CSTAR_TENANT_SETUP_URL=
CSTAR_API_URL=
