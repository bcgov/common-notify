# Environment Setup
# LOCAL: Kong admin API runs locally
# DEV/TEST/PROD: Use remote API Gateway with GraphQL
ENVIRONMENT=local

# Kong Admin API (used in local environment)
KONG_ADMIN_URL=http://localhost:8001
GATEWAY_OAUTH2_TOKEN_URL=http://kong:8000/oauth2/token

API_GATEWAY_NAMESPACE=ns.gw-fe8c5

# API Gateway Notify URL (for frontend to call API Gateway directly)
# LOCAL: Use local Kong (localhost for host machine, kong for Docker container)
VITE_API_GATEWAY_NOTIFY_URL=http://localhost:8000
# DEV: Use deployed API Gateway
# VITE_API_GATEWAY_NOTIFY_URL=https://coco-notify-gateway.dev.api.gov.ca

# Backend service credentials for Kong (service-to-service calls)
# Used when backend needs to call Kong with API key authentication
KONG_SERVICE_API_KEY=

# Frontend API endpoint
VITE_API_URL=/api

# Frontend Keycloak configuration
VITE_KEYCLOAK_CLIENT_ID=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=

AUTH_SERVER_URL=
AUTH_SERVER_REALM=
AUTH_SERVER_SSL_REQUIRED=
AUTH_SERVER_PUBLIC_CLIENT=
AUTH_SERVER_RESOURCE_NOTIFY=
AUTH_SERVER_RESOURCE_NOTIFY_SERVICE=

# Keycloak authentication
# Two realms are used:
# - standard realm: For frontend user requests (FRONTEND_KEYCLOAK_ISSUER)
# - apigw realm: For service-to-service requests (API_GATEWAY_KEYCLOAK_ISSUER)
JWKS_URI=
FRONTEND_KEYCLOAK_ISSUER=
API_GATEWAY_KEYCLOAK_ISSUER=
NOTIFY_CLIENT_ID=

# E2E Test Configuration
E2E_TEST_CLIENT_ID=
E2E_TEST_CLIENT_SECRET=

# Kong Admin API (for managing API keys)
#
# LOCAL DEVELOPMENT (docker-compose):
#   KONG_ADMIN_URL=http://kong:8000 (or http://localhost:8001 from host)
#   KONG_ADMIN_TOKEN_ENDPOINT=http://oauth2-mock:3002
#   KONG_ADMIN_CLIENT_ID=sa-notify-service
#   KONG_ADMIN_CLIENT_SECRET=notify-service-secret-12345678901234
#
# AZURE/PRODUCTION (BC Gov API Gateway):
#   Set KONG_ADMIN_URL to your Kong Admin API endpoint
#   Set KONG_ADMIN_TOKEN_ENDPOINT to your Keycloak token endpoint
#   Use your service account client_id and client_secret
#
KONG_ADMIN_URL=http://kong:8000
KONG_ADMIN_TOKEN_ENDPOINT=http://oauth2-mock:3002
KONG_ADMIN_CLIENT_ID=sa-notify-service
KONG_ADMIN_CLIENT_SECRET=notify-service-secret-12345678901234

# CHES passthrough
CHES_TOKEN_URL=
CHES_CLIENT_ID=
CHES_CLIENT_SECRET=
CHES_BASE_URL=
DEFAULT_EMAIL_FROM=

# ClamAV attachment scanning
# ClamAV daemon connection settings
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30000
CLAMAV_ENABLED=true

# When true, attachment scanning fails closed if ClamAV is disabled or unavailable.
# Leave false unless you want notification ingestion to retry instead of sending.
CLAMAV_FAIL_CLOSED=false

# GC Notify passthrough
GC_NOTIFY_BASE_URL=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# Job Queue Workers
# Number of ingestion jobs to process in parallel (default: 1)
INGESTION_WORKER_CONCURRENCY=1

# Number of email delivery jobs to process in parallel (default: 20)
# Raised so many small bulk batch jobs run concurrently.
EMAIL_DELIVERY_WORKER_CONCURRENCY=20

# Number of recipients per bulk-send delivery batch (default: 100)
BATCH_SIZE=100

# Notification Validation Limits
# Email channel limits
VALIDATE_EMAIL_MAX_RECIPIENTS=100
VALIDATE_EMAIL_MAX_SUBJECT_LENGTH=500
VALIDATE_EMAIL_MAX_BODY_LENGTH=50000

# SMS channel limits
VALIDATE_SMS_MAX_RECIPIENTS=50
VALIDATE_SMS_MAX_BODY_LENGTH=1600

# MsgApp channel limits
VALIDATE_MSGAPP_MAX_RECIPIENTS=100
VALIDATE_MSGAPP_MAX_BODY_LENGTH=50000

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ACS SMS Configuration
ACS_CONNECTION_STRING=
ACS_FROM_NUMBER=

# Delivery Adapter Selection
DELIVERY_EMAIL_ADAPTER=ches
DELIVERY_SMS_ADAPTER=twilio

# S3-compatible attachment storage
#
# Local docker-compose uses MinIO and sets these values directly in
# .devcontainer/docker-compose.yml.
#
# Local MinIO reference values:
#   S3_ENDPOINT=http://minio:9000
#   S3_BUCKET=notify-local
#   S3_REGION=us-east-1
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin123
#   S3_FORCE_PATH_STYLE=true
#
# OpenShift uses DELL ObjectScale. Credentials must come from
# objectstorage-secrets, not from this file.
#
# OpenShift bucket names:
#   dev:  notify-dev
#   test: notify-test
#   prod: notify-prod
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# CSTAR Integration (for role-based access control)
VITE_CSTAR_TENANT_SETUP_URL=
VITE_CSTAR_API_URL=
CSTAR_API_URL=

# APS Directory API — Credential Issuer (self-service API key issuing)
#
# Pick ONE of the three blocks below and set ALL SIX variables from it. Mixing values
# from two blocks is the failure mode to avoid: a token is only valid to the instance
# that issued it, so a half-switched config fails with a 401 that reads like a missing
# permission. The backend warns about this pairing at startup, but it is easier not to
# create it.
#
# ---------------------------------------------------------------------------
# 1. LOCAL MOCK (default — leave everything below blank)
# ---------------------------------------------------------------------------
# docker-compose points all six at the mock in oauth2-mock-server.js, which is backed
# by the local Kong. Keys it issues authenticate against local routes, so the whole
# issue -> send loop works offline. Nothing to set.
#
#   APS_API_BASE_URL=http://oauth2-mock:3002/ds/api/v3
#   APS_TOKEN_URL=http://oauth2-mock:3002/
#   APS_CLIENT_ID=sa-notify-service
#   APS_CLIENT_SECRET=notify-service-secret-12345678901234
#   APS_GATEWAY_ID=gw-local
#   APS_ENVIRONMENT_APP_ID=LOCAL001
#
# ---------------------------------------------------------------------------
# 2. APS TEST INSTANCE — exercises the real Credential Issuer API
# ---------------------------------------------------------------------------
# The Credential Issuer API is deployed only here, so this is the only way to test the
# real contract. Needs a gateway, a kong-api-key-only Product Environment, and a
# service account with CredentialIssuer.Generate, all created on the test instance —
# service accounts do not carry across instances.
#
# Caveat: keys issued here will NOT authenticate against your local Kong, because the
# consumer lives on that gateway. You can generate a key and not use it locally.
#
#   APS_API_BASE_URL=https://api-gov-bc-ca.test.api.gov.bc.ca/ds/api/v3
#   APS_TOKEN_URL=https://authz-apps-gov-bc-ca.test.api.gov.bc.ca/auth/realms/aps/protocol/openid-connect/token
#   APS_CLIENT_ID=<test-instance service account>
#   APS_CLIENT_SECRET=<test-instance secret>
#   APS_GATEWAY_ID=<test-instance gateway id>
#   APS_ENVIRONMENT_APP_ID=<Environment.appId on that gateway>
#
# ---------------------------------------------------------------------------
# 3. APS PRODUCTION INSTANCE — where gw-fe8c5 lives
# ---------------------------------------------------------------------------
# What deployed environments use. The Credential Issuer API is NOT here yet, so issuing
# returns 404 — this block is for reference and for when it ships.
#
# Every Generate creates a permanent Application and Consumer with no delete API, so
# think twice before pointing local development at it.
#
#   APS_API_BASE_URL=https://api.gov.bc.ca/ds/api/v3
#   APS_TOKEN_URL=https://authz.apps.gov.bc.ca/auth/realms/aps/protocol/openid-connect/token
#   APS_CLIENT_ID=<prod service account>
#   APS_CLIENT_SECRET=<prod secret>
#   APS_GATEWAY_ID=gw-fe8c5
#   APS_ENVIRONMENT_APP_ID=<Environment.appId — NOT the gateway id>
#
# See docs/api-key-self-service.md for how to obtain each value.
APS_API_BASE_URL=
APS_TOKEN_URL=
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_GATEWAY_ID=
APS_ENVIRONMENT_APP_ID=
# Shared ACL group every issued credential joins, alongside the tenant's own CSTAR-id
# group. Only meaningful on a kong-api-key-acl environment, where the gateway's acl
# plugin allows this one group and Kong then reports all of the consumer's groups in
# X-Consumer-Groups. Must match ACL_GROUP in api-gateway/config/*.env.
# Defaults to notify-api when unset.
APS_ACL_GROUP=
