# PR-specific Gateway Configuration
# This is used for temporary PR deployments in the DEV namespace
# Each PR gets its own isolated gateway configuration

# Gateway ID (using published gw-fe8c5 gateway)
GATEWAY_ID=gw-fe8c5

# Gateway service name includes PR number for uniqueness
GATEWAY_SERVICE_NAME=${GATEWAY_ID}-notify-pr-${PR_NUMBER}

# Backend host uses the PR-specific release name
BACKEND_HOST=${RELEASE_NAME}-backend.f6bc3f-dev.svc.cluster.local

# Route prefix includes PR number to avoid conflicts
ROUTE_PREFIX=${GATEWAY_ID}-pr-${PR_NUMBER}-

# PATH PREFIX for isolated PR routing on shared hostname
# Each PR gets unique path prefix: /pr-109/, /pr-113/, etc.
# Kong will strip this prefix before forwarding to backend
PATH_PREFIX=/pr-${PR_NUMBER}

# All PRs share the same DEV gateway hostname (path-based routing)
GATEWAY_HOSTNAME=${GATEWAY_ID}-notify.dev.api.gov.bc.ca

# DEV Keycloak configuration
KEYCLOAK_ISSUER=https://dev.loginproxy.gov.bc.ca/auth/realms/apigw
FRONTEND_KEYCLOAK_ISSUER=https://test.loginproxy.gov.bc.ca/auth/realms/standard
ALLOWED_AUDIENCE=ap-${GATEWAY_ID}-default-dev-dev
FRONTEND_ALLOWED_AUDIENCE=notify-6388

# Environment: PRs use DEV environment qualifier to avoid "too many qualified gateways" error
# Path prefix provides isolation between PRs, not tag qualifier
ENVIRONMENT=dev

# Per-API-key rate limit (requests/minute) applied to all key-auth service-to-service routes
API_KEY_RATE_LIMIT_PER_MINUTE=6000

# decK scopes its sync to the tag carried by the config: resources under other tags are
# invisible to it, so it tries to create them and Kong rejects the duplicate name. Changing
# this on a gateway that already has config published under the old tag orphans that config.
CONFIG_TAG=ns.${GATEWAY_ID}.${ENVIRONMENT}
