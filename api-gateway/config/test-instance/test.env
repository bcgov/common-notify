# TEST on the APS test-instance gateway (notify-test). Same shape as config/test.env on the
# production-instance gateway; see README.md in this directory.

ENVIRONMENT=test
GATEWAY_ID=notify-test
GATEWAY_SERVICE_NAME=${GATEWAY_ID}-notify-test
BACKEND_HOST=common-notify-test-backend.f6bc3f-test.svc.cluster.local
ROUTE_PREFIX=${GATEWAY_ID}-notify-test-

# Served by the test instance as notify-test-test-api-gov-bc-ca.test.api.gov.bc.ca.
GATEWAY_HOSTNAME=${GATEWAY_ID}.${ENVIRONMENT}.api.gov.bc.ca

FRONTEND_KEYCLOAK_ISSUER=https://test.loginproxy.gov.bc.ca/auth/realms/standard
FRONTEND_ALLOWED_AUDIENCE=notify-6388

PATH_PREFIX=
API_KEY_RATE_LIMIT_PER_MINUTE=6000
CONFIG_TAG=ns.${GATEWAY_ID}.${ENVIRONMENT}
