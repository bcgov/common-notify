# DEV on the APS test-instance gateway (notify-test). Same shape as config/dev.env on the
# production-instance gateway; see README.md in this directory for why it exists.

ENVIRONMENT=dev
GATEWAY_ID=notify-test
GATEWAY_SERVICE_NAME=${GATEWAY_ID}-notify-dev
BACKEND_HOST=${RELEASE_NAME}-backend.f6bc3f-dev.svc.cluster.local

# "-notify-" keeps route names clear of the credential-issuer sandbox, which already
# published notify-test-dev-* and notify-test-pr-<n>-* here. Route names are unique across
# the whole gateway, whatever their tag.
ROUTE_PREFIX=${GATEWAY_ID}-notify-dev-

# Published under this name; the test instance serves it as
# notify-test-dev-api-gov-bc-ca.test.api.gov.bc.ca.
GATEWAY_HOSTNAME=${GATEWAY_ID}.${ENVIRONMENT}.api.gov.bc.ca

# DEV's frontend authenticates against TEST Keycloak (keycloak-url in notify-frontend-config).
FRONTEND_KEYCLOAK_ISSUER=https://test.loginproxy.gov.bc.ca/auth/realms/standard
FRONTEND_ALLOWED_AUDIENCE=notify-6388

PATH_PREFIX=
API_KEY_RATE_LIMIT_PER_MINUTE=6000
CONFIG_TAG=ns.${GATEWAY_ID}.${ENVIRONMENT}
