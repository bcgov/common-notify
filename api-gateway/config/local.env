# LOCAL Environment Gateway Configuration
# For local development using Kong in Docker

ENVIRONMENT=local
GATEWAY_ID=gw-local
GATEWAY_SERVICE_NAME=gw-local-notify
BACKEND_HOST=backend:3000
ROUTE_PREFIX=gw-local-
# decK/Kong config tag. Written out in full rather than as ns.${GATEWAY_ID}.${ENVIRONMENT}:
# this file is read with dotenv.parse, which does no variable expansion, so a nested
# reference would be inserted into routes.yaml literally.
CONFIG_TAG=ns.gw-local.local
GATEWAY_HOSTNAME=localhost:8000
KEYCLOAK_ISSUER=http://keycloak:8080/auth/realms/apigw
FRONTEND_KEYCLOAK_ISSUER=http://keycloak:8080/auth/realms/standard
ALLOWED_AUDIENCE=ap-gw-local-default-local-local
FRONTEND_ALLOWED_AUDIENCE=notify-local

# No path prefix for local environment
PATH_PREFIX=

# Per-API-key rate limit (requests/minute) applied to all key-auth service-to-service routes
API_KEY_RATE_LIMIT_PER_MINUTE=6000
