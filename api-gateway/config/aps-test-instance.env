# APS TEST INSTANCE — sandbox gateway for the Credential Issuer API
#
# Administered at api-gov-bc-ca.test.api.gov.bc.ca, which is a different APS deployment
# from the one hosting gw-fe8c5. Service accounts, gateways and product environments do
# not carry across instances; everything referenced here exists only on the test one.
#
# Not consumed by any deploy pipeline. Applied by hand — see docs/api-key-self-service.md.

# Gateway (namespace) created with:
#   gwa gateway create --host api-gov-bc-ca.test.api.gov.bc.ca \
#     --gateway-id notify-test --display-name "Notify (test instance)"
GATEWAY_ID=notify-test

# Vanity subdomain for the data-plane host: <subdomain>.<environment>.api.gov.bc.ca.
# Chosen, not assigned — it only has to be unique.
SERVICE_SUBDOMAIN=notify-test

# Per-release service and route names, so several PRs can publish to this gateway at once
# without colliding — the same reason pr.env carries GATEWAY_SERVICE_NAME/ROUTE_PREFIX.
GATEWAY_SERVICE_NAME=${SERVICE_SUBDOMAIN}-${RELEASE_SUFFIX}
ROUTE_PREFIX=${SERVICE_SUBDOMAIN}-${RELEASE_SUFFIX}-

# Path prefix isolating this release on the shared sandbox hostname, mirroring the
# /pr-<n> prefix the production gateway uses. Empty for the permanent dev release.
PATH_PREFIX=${RELEASE_PATH_PREFIX}

# Environment qualifier within this gateway. One is enough for a sandbox; the dev/test/
# prod trio on the production gateway exists to mirror the deployed namespaces, which
# this has no equivalent of.
ENVIRONMENT=dev

# Route hostname. routes.yaml puts this on every route's `hosts:`, so without it every
# route is published host-less and matches nothing.
#
# Deliberately NOT the ${GATEWAY_ID}-notify.dev.api.gov.bc.ca shape the prod-gateway
# configs use — this is the value the sandbox gateway was already published with and
# accepted. APS then serves it under the flattened name, which is what you actually call:
#
#   published here : notify-test.dev.api.gov.bc.ca
#   resolves as    : notify-test-dev-api-gov-bc-ca.test.api.gov.bc.ca
#
# Confirmed by DNS: the flattened name answers, the dotted one does not.
GATEWAY_HOSTNAME=${SERVICE_SUBDOMAIN}.${ENVIRONMENT}.api.gov.bc.ca

# Upstream, resolved from the release being tested — the same pattern pr.env uses on the
# production gateway, so a PR's routes reach that PR's own backend rather than a shared
# one. RELEASE_NAME is supplied by the generator:
#
#   generate-gateway-config.sh aps-test-instance common-notify-210
#
# Defaults to the permanent dev release when no release is given, so a bare invocation
# still produces something valid.
#
# Whether the test instance's data plane can reach Silver at all is UNCONFIRMED — the
# production APS data plane has a path into f6bc3f-dev; whether the test one does is a
# question for the APS team. Issuing credentials does not depend on it, only spending
# the key does.
BACKEND_HOST=${RELEASE_NAME}-backend.f6bc3f-dev.svc.cluster.local

# Quoted: the parentheses would otherwise break `source` in the generator.
# routes.yaml carries jwt-keycloak plugins for the frontend routes. The Notify web app
# never calls this sandbox, so these exist only to make the template substitute cleanly;
# they mirror pr.env rather than inventing values.
FRONTEND_KEYCLOAK_ISSUER=https://test.loginproxy.gov.bc.ca/auth/realms/standard
FRONTEND_ALLOWED_AUDIENCE=notify-6388
API_KEY_RATE_LIMIT_PER_MINUTE=6000

PRODUCT_TITLE='Notify API (credential issuer sandbox)'

# Matches the existing Notify dataset on the production instance.
ORGANIZATION=ministry-of-citizens-services
ORGANIZATION_UNIT=devops-and-cloud-services

# Deliberately NOT the ns.${GATEWAY_ID}.${ENVIRONMENT} form the production-gateway configs
# use. The sandbox's service was first published under `ns.notify-test` by an earlier
# hand-written template, and decK only sees resources carrying the tag in the config it is
# given. Publishing under a new tag makes it try to *create* a service whose name already
# exists, which Kong rejects:
#
#   Create service notify-test-pr-210 failed: HTTP status 409
#   (message: "UNIQUE violation detected on '{name=\"notify-test-pr-210\"}'")
#
# Matching the published tag lets decK update the service in place instead. Do not "fix"
# this to match the other configs without first removing the existing service — and note
# that destroying the gateway to do so would issue a new environmentAppId and break
# APS_ENVIRONMENT_APP_ID.
CONFIG_TAG=ns.${GATEWAY_ID}

# The single group the acl plugin allows. Every credential Notify issues joins it, on top
# of the tenant's own CSTAR-id group. MUST match APS_ACL_GROUP in the backend environment
# (backend/src/config/configuration.ts defaults to the same value) — a mismatch is a 403
# on every request.
ACL_GROUP=notify-api
