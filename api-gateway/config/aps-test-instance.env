# APS TEST INSTANCE — sandbox gateway for the Credential Issuer API
#
# Administered at api-gov-bc-ca.test.api.gov.bc.ca, which is a different APS deployment
# from the one hosting gw-fe8c5. Service accounts, gateways and product environments do
# not carry across instances; everything referenced here exists only on the test one.
#
# Not consumed by any deploy pipeline. Applied by hand — see docs/api-key-self-service.md.

# Gateway (namespace) created with:
#   gwa gateway create --host api-gov-bc-ca.test.api.gov.bc.ca \
#     --gateway-id notify-test --display-name "Notify (test instance)"
GATEWAY_ID=notify-test

# Vanity subdomain for the data-plane host: <subdomain>.<environment>.api.gov.bc.ca.
# Chosen, not assigned — it only has to be unique.
SERVICE_SUBDOMAIN=notify-test

# Environment qualifier within this gateway. One is enough for a sandbox; the dev/test/
# prod trio on the production gateway exists to mirror the deployed namespaces, which
# this has no equivalent of.
ENVIRONMENT=dev

# Upstream. Points at the real dev backend so that IF the test instance's data plane can
# reach Silver, the published route works end to end. That reachability is UNCONFIRMED —
# the production APS data plane has a path into f6bc3f-dev, and whether the test one does
# is a question for the APS team. Issuing credentials does not depend on it.
BACKEND_HOST=common-notify-dev-backend.f6bc3f-dev.svc.cluster.local

# Quoted: the parentheses would otherwise break `source` in the generator.
PRODUCT_TITLE='Notify API (credential issuer sandbox)'

# Matches the existing Notify dataset on the production instance.
ORGANIZATION=ministry-of-citizens-services
ORGANIZATION_UNIT=devops-and-cloud-services
