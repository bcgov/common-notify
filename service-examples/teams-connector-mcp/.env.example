# Used by the Docker MCP Toolkit gateway (docker compose --profile gateway).
# The gateway's secret store keys secrets by "<server-name>.<secret-name>" as
# declared in catalog.yaml — NOT by the plain CONNECTOR_API_KEY name.
teams-connector.connector_api_key=your-api-key-here

# For the standalone Docker (docker run -e ...) or local Node.js paths, set
# the plain env var name directly instead — see README.md "Run" section.
# CONNECTOR_API_KEY=your-api-key-here

# Base URL of the devx-teams-connector instance (no trailing slash).
# Optional — defaults to the BC Gov relay deployment if unset. Only read by
# the standalone/local Node paths; the gateway path does not pass this through.
# TEAMS_CONNECTOR_URL=https://relay.developer.gov.bc.ca
