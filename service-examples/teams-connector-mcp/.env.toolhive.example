# Used by `thv run --env-file .env.toolhive` (see README.md "ToolHive" section).
# Plain variable names — passed straight through as container env vars, unlike
# the Docker MCP Toolkit gateway's .env, which needs the dotted secret name
# "teams-connector.connector_api_key" instead. Don't reuse one file for both.
CONNECTOR_API_KEY=your-api-key-here

# Base URL of the devx-teams-connector instance (no trailing slash).
# Optional — defaults to the BC Gov relay deployment if unset.
# TEAMS_CONNECTOR_URL=https://relay.developer.gov.bc.ca
