# Read by compose.yml (docker compose loads .env automatically from the project root).

# 64-character hex string (32 bytes) used by the backend to encrypt registered API keys at
# rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Postgres credentials — used both by the default "backend" container's built-in Postgres
# and by "postgres-dev" (the --profile dev standalone Postgres for local development).
POSTGRES_DATABASE=mcp_console
POSTGRES_USER=mcp_console
POSTGRES_PASSWORD=mcp_console

# Only used by postgres-dev (--profile dev).
POSTGRES_PORT=5433
