# Postgres (matches compose.yml's mapped host port, offset from 5432 to avoid clashing with
# any other local Postgres instance)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=mcp_console
POSTGRES_PASSWORD=mcp_console
POSTGRES_DATABASE=mcp_console

# 64-character hex string (32 bytes) used to encrypt registered API keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

PORT=3100
