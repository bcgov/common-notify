# ── Subscription MCP Server — environment variables ──────────────────────────
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# GitHub personal access token (classic: ghp_... or fine-grained: github_pat_...)
# Required scopes: "repo" for private repositories.
# Public repositories work without a token at reduced rate limits (60 req/hr).
# Can also be set at runtime via the set_github_token MCP tool.
GITHUB_TOKEN=

# Transport mode:
#   stdio           → Claude Desktop / MCP clients that communicate via stdin/stdout
#   http            → direct HTTP + streamable-HTTP (default for Docker HTTP mode)
#   sse             → legacy Server-Sent Events transport
#   streamable-http → explicit modern HTTP streaming
TRANSPORT=http

# HTTP server settings (only used when TRANSPORT != stdio)
PORT=8000
HOST=0.0.0.0

# Optional bearer token for HTTP transport.
# When set, clients must send:  Authorization: Bearer <value>
# Leave empty to allow unauthenticated local access.
MCP_API_KEY=
